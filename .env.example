# ─── Server Environment Variables ───────────────────────────────────────────

# Port the Express / Socket.IO server listens on
# Default: 8000
PORT=8000

# Allowed CORS origin (your frontend URL)
# Local dev:  http://localhost:3000
# Production: https://your-client-domain.com
CLIENT_URL=http://localhost:3000

# Redis connection URL
# Local dev:  redis://127.0.0.1:6379
# AWS ElastiCache (TLS): rediss://:password@your-cluster.cache.amazonaws.com:6380
REDIS_URL=redis://127.0.0.1:6379
